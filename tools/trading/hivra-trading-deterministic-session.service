[Unit]
Description=Hivra Trading bounded deterministic session
Documentation=https://github.com/WSorr/Hivra-App
Wants=network-online.target
After=network-online.target
Conflicts=hivra-trading-public-shadow-runner.service
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=/var/lib/hivra-trading-public-shadow
ExecStartPre=/usr/bin/test -x /opt/hivra/trading-public-shadow/hivra-trading-runner-lifecycle
ExecStart=/opt/hivra/trading-public-shadow/hivra-trading-runner-lifecycle --run-installed-prepared-session
Restart=no
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=mixed
OOMPolicy=stop
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/hivra-trading-public-shadow /var/lib/private/hivra-trading-public-shadow
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
IPAccounting=yes
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=1h
LogRateLimitBurst=400

[Install]
WantedBy=multi-user.target
